{
  "version": 2,
  "name": "EURUSD entry structure search",
  "setup": {
    "kind": "signals",
    "trading": "spreadbet"
  },
  "data": {
    "symbols": [
      "EURUSD=X"
    ],
    "timeframe": "1d",
    "start": "2019-01-01",
    "end": "2024-12-31"
  },
  "instruments": {
    "EURUSD=X": {
      "asset_class": "fx",
      "point_size": 0.0001,
      "base_currency": "EUR",
      "quote_currency": "USD",
      "min_size": 1.0,
      "increment": 0.01,
      "rounding": "floor",
      "spread_points": 0.9,
      "slippage": 0.0002,
      "leverage": 30
    }
  },
  "features": {
    "rsi": {
      "indicator": "talib:RSI",
      "inputs": {
        "close": "close"
      },
      "params": {
        "timeperiod": 14
      }
    },
    "upper": {
      "indicator": "talib:MAX",
      "inputs": {
        "close": "high"
      },
      "params": {
        "timeperiod": 20
      }
    },
    "lower": {
      "indicator": "talib:MIN",
      "inputs": {
        "close": "low"
      },
      "params": {
        "timeperiod": 10
      }
    },
    "trend": {
      "indicator": "talib:SMA",
      "inputs": {
        "close": "close"
      },
      "params": {
        "timeperiod": 200
      }
    }
  },
  "rules": {
    "long_entry": {
      "choose": "reversion",
      "options": {
        "reversion": {
          "conditions": {
            "A": {
              "left": {
                "feature": "rsi"
              },
              "op": "crosses_above",
              "right": {
                "const": 30.0
              }
            },
            "B": {
              "left": {
                "price": "close"
              },
              "op": ">",
              "right": {
                "feature": "trend"
              }
            }
          },
          "logic": "A and B"
        },
        "breakout": {
          "conditions": {
            "A": {
              "left": {
                "price": "close"
              },
              "op": ">",
              "right": {
                "feature": "upper",
                "shift": 1
              }
            }
          },
          "logic": "A"
        }
      }
    },
    "long_exit": {
      "conditions": {
        "A": {
          "left": {
            "price": "close"
          },
          "op": "<",
          "right": {
            "feature": "lower",
            "shift": 1
          }
        },
        "B": {
          "left": {
            "feature": "rsi"
          },
          "op": ">",
          "right": {
            "const": 75.0
          }
        }
      },
      "logic": "A or B"
    },
    "short_entry": null,
    "short_exit": null
  },
  "risk": {
    "sizing": {
      "risk_pct": 0.01
    },
    "stop": {
      "kind": "fixed",
      "points": 60
    },
    "target": {
      "points": 120
    }
  },
  "account": {
    "init_cash": 10000,
    "freq": "D",
    "rates": {
      "source": "static",
      "values": {
        "EUR": 0.03,
        "USD": 0.045
      }
    }
  },
  "engine_extra": {
    "upon_opposite_entry": "reverse",
    "seed": 42
  },
  "optimise": {
    "variables": {
      "features.rsi.params.timeperiod": {
        "start": 5,
        "stop": 30,
        "step": 2
      },
      "features.upper.params.timeperiod": {
        "start": 10,
        "stop": 60,
        "step": 5
      },
      "rules.long_entry.choose": {
        "values": [
          "reversion",
          "breakout"
        ]
      },
      "rules.long_entry.options.reversion.conditions.A.right.const": {
        "start": 15,
        "stop": 40
      }
    }
  }
}
