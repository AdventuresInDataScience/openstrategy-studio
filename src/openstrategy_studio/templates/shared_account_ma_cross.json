{
  "version": 2,
  "name": "Three stocks, one account: MA cross, strongest first",
  "setup": {
    "kind": "signals",
    "trading": "equity"
  },
  "data": {
    "symbols": [
      "AAPL",
      "MSFT",
      "NVDA"
    ],
    "timeframe": "1d",
    "start": "2015-01-01",
    "end": "2024-12-31"
  },
  "instruments": {
    "AAPL": {
      "point_size": 0.01,
      "quote_currency": "USD",
      "cost_currency": "USD",
      "commission_pct": 0.0005,
      "leverage": 1.0
    },
    "MSFT": {
      "point_size": 0.01,
      "quote_currency": "USD",
      "cost_currency": "USD",
      "commission_pct": 0.0005,
      "leverage": 1.0
    },
    "NVDA": {
      "point_size": 0.01,
      "quote_currency": "USD",
      "cost_currency": "USD",
      "commission_pct": 0.0005,
      "leverage": 1.0
    }
  },
  "features": {
    "fast": {
      "indicator": "talib:SMA",
      "inputs": {
        "close": "close"
      },
      "params": {
        "timeperiod": 20
      }
    },
    "slow": {
      "indicator": "talib:SMA",
      "inputs": {
        "close": "close"
      },
      "params": {
        "timeperiod": 100
      }
    },
    "strength": {
      "indicator": "talib:ROCP",
      "inputs": {
        "close": "close"
      },
      "params": {
        "timeperiod": 63
      }
    }
  },
  "rules": {
    "long_entry": {
      "conditions": {
        "A": {
          "left": {
            "feature": "fast"
          },
          "op": "crosses_above",
          "right": {
            "feature": "slow"
          }
        }
      },
      "logic": "A"
    },
    "long_exit": {
      "conditions": {
        "A": {
          "left": {
            "feature": "fast"
          },
          "op": "crosses_below",
          "right": {
            "feature": "slow"
          }
        }
      },
      "logic": "A"
    },
    "short_entry": null,
    "short_exit": null
  },
  "risk": {
    "sizing": {
      "notional": 4500
    },
    "stop": {
      "kind": "none"
    },
    "target": null
  },
  "account": {
    "init_cash": 10000,
    "freq": "D",
    "cash": "shared",
    "entry_priority": {
      "by": "feature",
      "score": {
        "feature": "strength"
      },
      "highest_first": true
    },
    "when_cash_short": "skip"
  },
  "engine_extra": {},
  "optimise": {
    "variables": {
      "features.fast.params.timeperiod": {
        "start": 5,
        "stop": 50,
        "step": 4
      },
      "features.slow.params.timeperiod": {
        "start": 60,
        "stop": 200,
        "step": 14
      }
    }
  }
}
