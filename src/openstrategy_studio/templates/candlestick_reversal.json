{
  "version": 2,
  "name": "EURUSD hammer reversal",
  "setup": {
    "kind": "signals",
    "trading": "spreadbet"
  },
  "data": {
    "symbols": [
      "EURUSD=X"
    ],
    "timeframe": "1d",
    "start": "2015-01-01",
    "end": "2024-12-31"
  },
  "instruments": {
    "EURUSD=X": {
      "asset_class": "fx",
      "point_size": 0.0001,
      "base_currency": "EUR",
      "quote_currency": "USD",
      "min_size": 1.0,
      "increment": 0.01,
      "rounding": "floor",
      "spread_points": 0.9,
      "slippage": 0.0002,
      "leverage": 30
    }
  },
  "features": {
    "rsi": {
      "indicator": "talib:RSI",
      "inputs": {
        "close": "close"
      },
      "params": {
        "timeperiod": 14
      }
    },
    "hammer": {
      "indicator": "pattern:candle:hammer",
      "inputs": {},
      "params": {
        "shadow_factor": 2.0,
        "require_trend": true
      }
    }
  },
  "rules": {
    "long_entry": {
      "conditions": {
        "A": {
          "pattern": "hammer",
          "side": "bullish"
        },
        "B": {
          "left": {
            "feature": "rsi"
          },
          "op": "<",
          "right": {
            "const": 40.0
          }
        }
      },
      "logic": "A and B"
    },
    "long_exit": {
      "conditions": {
        "A": {
          "left": {
            "feature": "rsi"
          },
          "op": "crosses_above",
          "right": {
            "const": 60.0
          }
        }
      },
      "logic": "A"
    },
    "short_entry": null,
    "short_exit": null
  },
  "risk": {
    "sizing": {
      "risk_pct": 0.01
    },
    "stop": {
      "kind": "fixed",
      "points": 50
    },
    "target": {
      "points": 100
    }
  },
  "account": {
    "init_cash": 10000,
    "freq": "D"
  },
  "engine_extra": {},
  "optimise": {
    "variables": {
      "features.hammer.params.shadow_factor": {
        "start": 1.2,
        "stop": 3.0,
        "step": 0.2
      }
    }
  }
}
