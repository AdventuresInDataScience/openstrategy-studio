{
  "version": 1,
  "name": "EURUSD 50/200 MA cross",
  "data": {
    "symbols": [
      "EURUSD=X"
    ],
    "timeframe": "1d",
    "start": "2019-01-01",
    "end": "2024-12-31"
  },
  "instruments": {
    "EURUSD=X": {
      "mode": "spreadbet",
      "asset_class": "fx",
      "point_size": 0.0001,
      "base_currency": "EUR",
      "quote_currency": "USD",
      "min_size": 1.0,
      "increment": 0.01,
      "rounding": "floor",
      "spread_points": 0.9,
      "slippage": 0.0002,
      "leverage": 30
    }
  },
  "features": {
    "fast": {
      "block": "ma",
      "source": "close",
      "window": {
        "value": 50,
        "opt": {
          "min": 10,
          "max": 100,
          "int": true
        }
      }
    },
    "slow": {
      "block": "ma",
      "source": "close",
      "window": {
        "value": 200,
        "opt": {
          "min": 100,
          "max": 300,
          "int": true
        }
      }
    }
  },
  "rules": {
    "long_entry": {
      "all": [
        {
          "left": {
            "feature": "fast"
          },
          "op": "crosses_above",
          "right": {
            "feature": "slow"
          }
        }
      ]
    },
    "long_exit": {
      "all": [
        {
          "left": {
            "feature": "fast"
          },
          "op": "crosses_below",
          "right": {
            "feature": "slow"
          }
        }
      ]
    },
    "short_entry": null,
    "short_exit": null
  },
  "risk": {
    "sizing": {
      "risk_pct": 0.01
    },
    "stop": {
      "kind": "fixed",
      "points": 60
    },
    "target": {
      "points": 120
    }
  },
  "account": {
    "init_cash": 10000,
    "freq": "D",
    "rates": {
      "source": "static",
      "values": {
        "EUR": 0.03,
        "USD": 0.045
      }
    }
  },
  "engine_extra": {
    "upon_opposite_entry": "reverse",
    "seed": 42
