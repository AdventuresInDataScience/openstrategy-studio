{
  "version": 2,
  "name": "SPY RSI reversion",
  "setup": {
    "kind": "signals",
    "trading": "equity"
  },
  "data": {
    "symbols": [
      "SPY"
    ],
    "timeframe": "1d",
    "start": "2015-01-01",
    "end": "2024-12-31"
  },
  "instruments": {
    "SPY": {
      "point_size": 0.01,
      "quote_currency": "USD",
      "cost_currency": "USD",
      "commission_pct": 0.0005
    }
  },
  "features": {
    "rsi": {
      "indicator": "talib:RSI",
      "inputs": {
        "close": "close"
      },
      "params": {
        "timeperiod": 14
      }
    },
    "trend": {
      "indicator": "talib:SMA",
      "inputs": {
        "close": "close"
      },
      "params": {
        "timeperiod": 200
      }
    }
  },
  "rules": {
    "long_entry": {
      "conditions": {
        "A": {
          "left": {
            "feature": "rsi"
          },
          "op": "crosses_above",
          "right": {
            "const": 30.0
          }
        },
        "B": {
          "left": {
            "price": "close"
          },
          "op": ">",
          "right": {
            "feature": "trend"
          }
        }
      },
      "logic": "A and B"
    },
    "long_exit": {
      "conditions": {
        "A": {
          "left": {
            "feature": "rsi"
          },
          "op": "crosses_above",
          "right": {
            "const": 70.0
          }
        }
      },
      "logic": "A"
    },
    "short_entry": null,
    "short_exit": null
  },
  "risk": {
    "sizing": {
      "notional": 9000
    },
    "stop": {
      "kind": "none"
    },
    "target": null
  },
  "account": {
    "init_cash": 10000,
    "freq": "D"
  },
  "engine_extra": {},
  "optimise": {
    "variables": {
      "features.rsi.params.timeperiod": {
        "start": 5,
        "stop": 30,
        "step": 2
      },
      "rules.long_entry.conditions.A.right.const": {
        "start": 15,
        "stop": 40
      },
      "rules.long_exit.conditions.A.right.const": {
        "start": 55,
        "stop": 85
      }
    }
  }
}
