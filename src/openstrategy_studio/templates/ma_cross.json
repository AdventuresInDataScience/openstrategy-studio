{
  "version": 2,
  "name": "EURUSD 50/200 MA cross",
  "setup": {
    "kind": "signals",
    "trading": "spreadbet"
  },
  "data": {
    "symbols": [
      "EURUSD=X"
    ],
    "timeframe": "1d",
    "start": "2019-01-01",
    "end": "2024-12-31"
  },
  "instruments": {
    "EURUSD=X": {
      "asset_class": "fx",
      "point_size": 0.0001,
      "base_currency": "EUR",
      "quote_currency": "USD",
      "min_size": 1.0,
      "increment": 0.01,
      "rounding": "floor",
      "spread_points": 0.9,
      "slippage": 0.0002,
      "leverage": 30
    }
  },
  "features": {
    "fast": {
      "indicator": "talib:SMA",
      "inputs": {
        "close": "close"
      },
      "params": {
        "timeperiod": 50
      }
    },
    "slow": {
      "indicator": "talib:SMA",
      "inputs": {
        "close": "close"
      },
      "params": {
        "timeperiod": 200
      }
    }
  },
  "rules": {
    "long_entry": {
      "conditions": {
        "A": {
          "left": {
            "feature": "fast"
          },
          "op": "crosses_above",
          "right": {
            "feature": "slow"
          }
        }
      },
      "logic": "A"
    },
    "long_exit": {
      "conditions": {
        "A": {
          "left": {
            "feature": "fast"
          },
          "op": "crosses_below",
          "right": {
            "feature": "slow"
          }
        }
      },
      "logic": "A"
    },
    "short_entry": null,
    "short_exit": null
  },
  "risk": {
    "sizing": {
      "risk_pct": 0.01
    },
    "stop": {
      "kind": "fixed",
      "points": 60
    },
    "target": {
      "points": 120
    }
  },
  "account": {
    "init_cash": 10000,
    "freq": "D",
    "rates": {
      "source": "static",
      "values": {
        "EUR": 0.03,
        "USD": 0.045
      }
    }
  },
  "engine_extra": {
    "upon_opposite_entry": "reverse",
    "seed": 42
  },
  "optimise": {
    "variables": {
      "features.fast.params.timeperiod": {
        "start": 10,
        "stop": 100,
        "step": 9
      },
      "features.slow.params.timeperiod": {
        "start": 100,
        "stop": 300,
        "step": 20
      }
    }
  }
}
