{
  "version": 2,
  "name": "GBPUSD Donchian breakout",
  "setup": {
    "kind": "signals",
    "trading": "spreadbet"
  },
  "data": {
    "symbols": [
      "GBPUSD=X"
    ],
    "timeframe": "1d",
    "start": "2015-01-01",
    "end": "2024-12-31"
  },
  "instruments": {
    "GBPUSD=X": {
      "asset_class": "fx",
      "point_size": 0.0001,
      "base_currency": "GBP",
      "quote_currency": "USD",
      "min_size": 1.0,
      "increment": 0.01,
      "rounding": "floor",
      "spread_points": 1.2,
      "slippage": 0.0002,
      "leverage": 30
    }
  },
  "features": {
    "entry_high": {
      "indicator": "talib:MAX",
      "inputs": {
        "close": "high"
      },
      "params": {
        "timeperiod": 20
      }
    },
    "entry_low": {
      "indicator": "talib:MIN",
      "inputs": {
        "close": "low"
      },
      "params": {
        "timeperiod": 20
      }
    },
    "exit_high": {
      "indicator": "talib:MAX",
      "inputs": {
        "close": "high"
      },
      "params": {
        "timeperiod": 10
      }
    },
    "exit_low": {
      "indicator": "talib:MIN",
      "inputs": {
        "close": "low"
      },
      "params": {
        "timeperiod": 10
      }
    }
  },
  "rules": {
    "long_entry": {
      "conditions": {
        "A": {
          "left": {
            "price": "close"
          },
          "op": ">",
          "right": {
            "feature": "entry_high",
            "shift": 1
          }
        }
      },
      "logic": "A"
    },
    "long_exit": {
      "conditions": {
        "A": {
          "left": {
            "price": "close"
          },
          "op": "<",
          "right": {
            "feature": "exit_low",
            "shift": 1
          }
        }
      },
      "logic": "A"
    },
    "short_entry": {
      "conditions": {
        "A": {
          "left": {
            "price": "close"
          },
          "op": "<",
          "right": {
            "feature": "entry_low",
            "shift": 1
          }
        }
      },
      "logic": "A"
    },
    "short_exit": {
      "conditions": {
        "A": {
          "left": {
            "price": "close"
          },
          "op": ">",
          "right": {
            "feature": "exit_high",
            "shift": 1
          }
        }
      },
      "logic": "A"
    }
  },
  "risk": {
    "sizing": {
      "risk_pct": 0.01
    },
    "stop": {
      "kind": "fixed",
      "points": 80
    },
    "target": null
  },
  "account": {
    "init_cash": 10000,
    "freq": "D"
  },
  "engine_extra": {
    "upon_opposite_entry": "reverse"
  },
  "optimise": {
    "variables": {
      "features.entry_high.params.timeperiod": {
        "start": 10,
        "stop": 60,
        "step": 5
      },
      "features.entry_low.params.timeperiod": {
        "start": 10,
        "stop": 60,
        "step": 5
      },
      "risk.stop.points": {
        "start": 30,
        "stop": 200,
        "step": 17
      }
    }
  }
}
